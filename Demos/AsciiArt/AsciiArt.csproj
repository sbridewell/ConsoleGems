    </None>
    <None Update="TestImages\GreenSquare.bmp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="TestImages\CyanSquare.bmp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="TestImages\high-colour.gif">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
